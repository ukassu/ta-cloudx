# Cloud Dynamics controlled experiment configuration.
# Defaults are local and portable.
# Export HOST_IP before running to target another reachable cluster, e.g.:
#   export HOST_IP=10.28.84.254
#
# Exported environment variables take precedence in the runner.
HOST_IP=127.0.0.1
HOST_IP=10.28.84.254
TARGET_SCHEME=http
TARGET_HOST=
TARGET_PATH=/
TARGET_URL="http://stateless-api.${HOST_IP}.sslip.io/"

REQUEST_TIMEOUT=5
WARMUP_SECONDS=30
WARMUP_RPS=5
COOLDOWN_SECONDS=15
SAMPLE_INTERVAL=1

APPLICATION_NAME=cloud-dynamics-app
APPLICATION_ARCHITECTURE=unspecified
REPLICAS=unspecified
CPU_REQUEST=unspecified
CPU_LIMIT=unspecified
MEMORY_REQUEST=unspecified
MEMORY_LIMIT=unspecified
REPLICATE=4
