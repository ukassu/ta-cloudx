# PromQL expressions.
# Variables __NAMESPACE__ and __APP__ are replaced by the collector.

CPU_USAGE=sum by (pod) (rate(container_cpu_usage_seconds_total{namespace="__NAMESPACE__",pod=~"__APP__.*",container!="",container!="POD"}[1m]))
CPU_THROTTLED=sum by (pod) (rate(container_cpu_cfs_throttled_seconds_total{namespace="__NAMESPACE__",pod=~"__APP__.*",container!="",container!="POD"}[1m]))
MEMORY_WORKING_SET=sum by (pod) (container_memory_working_set_bytes{namespace="__NAMESPACE__",pod=~"__APP__.*",container!="",container!="POD"})
NETWORK_RX=sum by (pod) (rate(container_network_receive_bytes_total{namespace="__NAMESPACE__",pod=~"__APP__.*"}[1m]))
NETWORK_TX=sum by (pod) (rate(container_network_transmit_bytes_total{namespace="__NAMESPACE__",pod=~"__APP__.*"}[1m]))
RESTARTS=sum by (pod) (kube_pod_container_status_restarts_total{namespace="__NAMESPACE__",pod=~"__APP__.*"})
READY_PODS=sum(kube_pod_status_ready{namespace="__NAMESPACE__",pod=~"__APP__.*",condition="true"})

# Linkerd metrics. These return empty datasets when Linkerd metrics are not present.
LINKERD_REQUEST_RATE=sum(rate(request_total{namespace="__NAMESPACE__",direction="inbound",dst=~"__APP__.*"}[1m]))
LINKERD_SUCCESS_RATE=sum(rate(response_total{namespace="__NAMESPACE__",direction="inbound",dst=~"__APP__.*",classification="success"}[1m])) / sum(rate(response_total{namespace="__NAMESPACE__",direction="inbound",dst=~"__APP__.*"}[1m]))
LINKERD_LATENCY_P95=histogram_quantile(0.95,sum by (le) (rate(response_latency_ms_bucket{namespace="__NAMESPACE__",direction="inbound",dst=~"__APP__.*"}[1m])))
